# Copier dans le gestionnaire de secrets de l’hébergeur. Ne jamais committer le fichier rempli.
ENVIRONMENT=production

# Générer deux valeurs indépendantes (au moins 32 octets aléatoires chacune).
SECRET_KEY=REPLACE_WITH_A_RANDOM_SECRET
JWT_SECRET_KEY=REPLACE_WITH_A_DIFFERENT_RANDOM_SECRET
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60
SESSION_MAX_AGE_SECONDS=43200

# PostgreSQL managé ; encoder les caractères spéciaux du mot de passe dans l’URL.
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@DB_HOST:5432/DATABASE

# HTTPS public et domaines acceptés, sans protocole ni chemin dans ALLOWED_HOSTS.
PUBLIC_BASE_URL=https://app.example.com
ALLOWED_HOSTS=app.example.com
# Mettre 1 si un seul proxy de confiance (Nginx, Caddy ou load balancer) est devant l’application.
TRUSTED_PROXY_COUNT=1

# Compte de secours plateforme créé au premier démarrage.
ADMIN_USERNAME=platform-admin
ADMIN_PASSWORD=REPLACE_WITH_A_UNIQUE_PASSWORD_OF_16_CHARACTERS_OR_MORE
ADMIN_EMAIL=ops@example.com
ADMIN_SYNC_PASSWORD=false

# Redis privé, partagé entre toutes les instances web.
RATE_LIMIT_REDIS_URL=rediss://:PASSWORD@REDIS_HOST:6379/0

# Facultatif : laisser les trois champs vides pour désactiver le Web Push.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:ops@example.com
PUSH_OUTBOX_POLL_SECONDS=2

TRIAL_EVENT_LIMIT=2
SUBSCRIPTION_GRACE_DAYS=7
BACKUP_DIR=./backups
