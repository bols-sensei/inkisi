APP_NAME=Invitation Access Control
SECRET_KEY=replace-with-a-long-random-secret-before-deployment
JWT_SECRET_KEY=replace-with-a-different-long-random-jwt-secret
JWT_EXPIRE_MINUTES=60
JWT_ALGORITHM=HS256

DATABASE_URL=sqlite:///./invitations.db
ADMIN_USERNAME=admin
ADMIN_PASSWORD=ChangeMe-123!
BASE_URL=http://127.0.0.1:8000

# Runtime / production
ENVIRONMENT=development
PUBLIC_BASE_URL=http://127.0.0.1:8000
# En développement, laissez vide (ou listez aussi l'IP de votre PC pour tester depuis un téléphone).
# ALLOWED_HOSTS=localhost,127.0.0.1


# Web Push (generate VAPID keys with pywebpush tooling)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com
RATE_LIMIT_REDIS_URL=
BACKUP_DIR=./backups

# SaaS (lot 1)
ADMIN_EMAIL=
TRIAL_EVENT_LIMIT=2
SUBSCRIPTION_GRACE_DAYS=7
# Tests uniquement (ignoré en production) :
# RATE_LIMIT_DISABLED=true

# Sécurité (lot 2)
# ENVIRONMENT doit être défini explicitement : sans valeur, l'application démarre en mode PRODUCTION (échec fermé).
# Nombre de reverse proxies de confiance devant l'application (0 = aucun ; 1 = nginx/Caddy/Cloudflare seul…).
TRUSTED_PROXY_COUNT=0
# Durée de la session navigateur (secondes) ; 12 h par défaut.
SESSION_MAX_AGE_SECONDS=43200
